# Copy to .env and fill in. NEVER commit .env!

# ── Core APIs (required for Phase 1) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
HEYGEN_API_KEY=...
ELEVENLABS_API_KEY=...

# ── Monitoring (required for Reel-Scraping) ───────────────────────────────
APIFY_API_TOKEN=apify_api_...

# ── Notifications (Telegram-Bot) ──────────────────────────────────────────
# Bot anlegen: @BotFather auf Telegram → /newbot → Token holen
# Chat-ID holen: Bot anschreiben, dann https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Posting (Phase 1.5) ───────────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=

# ── Optional (Phase 2+) ───────────────────────────────────────────────────
HIGGSFIELD_API_KEY=
MANYCHAT_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
